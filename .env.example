# SoundTeacher / SoungTeacher — environment placeholders (Dilim A+B)
# Copy to `.env.local` for local development. Never commit real secrets.

# --- Auth.js (next-auth v5) — Dilim B choice; Clerk not wired ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-soundteacher-auth-secret
AUTH_URL=http://localhost:3000
# Optional OAuth later:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Stripe Billing (test mode). Leave empty → labeled MOCK checkout/webhooks ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_TRIAL=

# --- Postgres (schema draft only; Dilim B uses in-memory mock store) ---
DATABASE_URL=postgresql://user:password@localhost:5432/soundteacher

# --- Object storage (S3-compatible: R2 / S3) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- TTS (paid cloud optional later; Dilim H uses browser Web Speech) ---
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=
TTS_BASE_URL=

# --- Audio retention (Saklama A = discard after analysis; see src/lib/audio-retention.ts) ---
# AUDIO_RETENTION_POLICY=saklama-a
