# SoundTeacher / SoungTeacher — environment placeholders (Dilim A)
# Copy to `.env.local` for local development. Never commit real secrets.

# --- Auth (Clerk or Auth.js — decision open until Dilim B) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_CLERK_PUBLISHABLE_KEY=
# AUTH_CLERK_SECRET_KEY=

# --- Stripe Billing (Dilim B) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_TRIAL=

# --- Postgres ---
DATABASE_URL=postgresql://user:password@localhost:5432/soundteacher

# --- Object storage (S3-compatible: R2 / S3) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- TTS (ElevenLabs / Azure / Google — Dilim E+) ---
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=
TTS_BASE_URL=
